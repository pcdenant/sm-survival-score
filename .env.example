# Ghost Admin API — requis en production (Vercel env vars)
# Créer via Ghost admin → Settings → Integrations → Custom integration
GHOST_ADMIN_API_KEY=your_ghost_id:your_ghost_hex_secret
GHOST_URL=https://your-site.ghost.io

# CTA PDF — liens Collaboration Solved (optionnels, affichés dans le rapport PDF)
VITE_COLLAB_SOLVED_URL=
VITE_COLLAB_SOLVED_EMAIL=
